# Copiar SOLO a Secrets de Streamlit o .streamlit/secrets.toml (ignorado).
# No compartir la clave por chat, GitHub, capturas ni informes.
GEMINI_API_KEY = ""
GEMINI_MODEL = ""
# El responsable debe verificar modelo, cuota gratuita y ausencia de facturación.
# Seleccionar un modelo disponible para la cuenta; no hay cambio automático de modelo.
GEMINI_FREE_TIER_CONFIRMED = false
# Solo demo está habilitado. Otros entornos fallan de forma cerrada.
APP_ENV = "demo"
# false deshabilita toda consulta remota de explicación desde la aplicación.
GEMINI_ENABLED = true
# URL HTTPS del servicio externo autorizado por el responsable, sin parámetros
# ni identificadores. Vacío mantiene «Consultar Sentinel» deshabilitado.
# No constituye integración automática ni proporciona un score.
SENTINEL_URL = ""
